// %(title)s — a first-party FinnOS app.
//
// The name follows the house rule: the brand and a plain English noun.
// A screen is named after the app it belongs to, and the file is named
// after the screen.
//
// The tokens come from the theme beside the app, so a screen refers to
// `token.surface` rather than to a colour: the appearance switch is a
// property of the whole theme.
//
// Compile it with:
//     fuic compile %(id)s.fui -o %(id)s.fbin
screen %(name)s {
  target: Desktop (primary)
  adapt(Mobile): windows->fullscreen
  adapt(TV): windows->fullscreen_single

  Column(padding:20, gap:12) {
    Text("%(title)s", style:title)
    Text("Nothing here yet.", style:body_dim)
  }
}
