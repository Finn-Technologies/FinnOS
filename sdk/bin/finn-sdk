#!/bin/sh
# finn-sdk — the control-plane client, run from a checkout.
#
# The SDK has no dependencies and does not have to be installed to be
# used: this wrapper puts the SDK on the path and runs the client.
set -e

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PYTHONPATH="$here/..${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

exec python3 -m finnsdk.cli "$@"
