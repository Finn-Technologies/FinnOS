# FinnOS — the house style, for every file in the tree.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h}]
indent_size = 4
max_line_length = 88

[Makefile]
indent_style = tab

[*.{py,sh}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{fui,svg}]
indent_size = 2
