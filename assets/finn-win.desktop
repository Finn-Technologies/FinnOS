[Desktop Entry]
Type=Application
Name=FinnOS Windows Runner
Comment=Run Windows 11 executables and installers via Proton or Wine
Exec=/usr/local/bin/finn-win %f
Icon=window
NoDisplay=true
Terminal=false
MimeType=application/x-ms-dos-executable;application/x-msi;application/x-msdos-program;application/vnd.microsoft.portable-executable;
