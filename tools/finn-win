def _find_proton_wine() -> Optional[str]:
    home = os.path.expanduser("~")
    patterns = [
        os.path.join(home, ".local/share/Steam/compatibilitytools.d/*/files/bin/wine64"),
        os.path.join(home, ".local/share/Steam/compatibilitytools.d/*/files/bin/wine"),
        "/usr/share/steam/compatibilitytools.d/*/files/bin/wine64",
        "/usr/share/steam/compatibilitytools.d/*/files/bin/wine",
        os.path.join(home, ".local/share/Steam/steamapps/common/Proton*/files/bin/wine64"),
        os.path.join(home, ".local/share/Steam/steamapps/common/Proton*/files/bin/wine"),
    ]
    for pat in patterns:
        matches = sorted(glob.glob(pat), reverse=True)
        for m in matches:
            if os.access(m, os.X_OK):
                return m
    return None


def _elf_is_aarch64(path: Optional[str]) -> bool:
    if not path:
        return False
    try:
        real = os.path.realpath(path)
        with open(real, "rb") as f:
            hdr = f.read(20)
        return len(hdr) >= 20 and hdr[:4] == b"\x7fELF" and int.from_bytes(hdr[18:20], "little") == 183
    except OSError:
        return False


def _detect_runtime() -> Dict[str, object]:
    arch = platform.machine().lower()
    override = os.environ.get("FINN_WIN_RUNTIME", "").strip()
    proton_bin = _find_proton_wine()
    wine_bin = shutil.which("wine") or shutil.which("wine64")
    emu_bin = shutil.which("FEXInterpreter") or shutil.which("box64")

    selected_bin = None
    engine = "none"
    if override and os.access(override, os.X_OK):
        selected_bin = override
        engine = "custom"
    elif proton_bin:
        selected_bin = proton_bin
        engine = "proton"
    elif wine_bin:
        selected_bin = wine_bin
        engine = "wine"

    dxvk_dirs = [
        "/usr/share/dxvk/x64",
        "/usr/lib/dxvk/x64",
        "/usr/share/wine/dxvk/x64",
    ]
    dxvk_path = next((d for d in dxvk_dirs if os.path.isdir(d)), None)

    vkd3d_dirs = [
        "/usr/share/vkd3d-proton/x64",
        "/usr/lib/vkd3d-proton/x64",
    ]
    vkd3d_path = next((d for d in vkd3d_dirs if os.path.isdir(d)), None)

    prefix = os.environ.get("FINN_WIN_PREFIX") or os.environ.get("WINEPREFIX") or DEFAULT_PREFIX
    prefix_ready = os.path.isfile(os.path.join(prefix, "system.reg"))
    win11_stamp = os.path.isfile(os.path.join(prefix, ".finn-win11-ready"))

    native_arm_wine = (arch not in ("x86_64", "amd64")) and _elf_is_aarch64(selected_bin)
    ready = bool(selected_bin) and (arch in ("x86_64", "amd64") or native_arm_wine or bool(emu_bin))
    return {
        "host_arch": arch,
        "engine": engine,
        "selected_bin": selected_bin,
        "native_arm_wine": native_arm_wine,
        "proton_bin": proton_bin,
        "wine_bin": wine_bin,
        "emulator_bin": emu_bin,
        "dxvk_path": dxvk_path,
        "vkd3d_path": vkd3d_path,
        "prefix": prefix,
        "prefix_initialized": prefix_ready,
        "win11_configured": win11_stamp,
        "wayland": bool(os.environ.get("WAYLAND_DISPLAY")),
        "xdisplay": os.environ.get("DISPLAY") or "",
        "ready": ready,
    }


def _build_env(rt: Dict[str, object]) -> Dict[str, str]:
    env = dict(os.environ)
    env["WINEPREFIX"] = str(rt["prefix"])
    env["WINEARCH"] = "win64"
    env["WINEESYNC"] = "1"
    env["WINEFSYNC"] = "1"
    env["PROTON_ENABLE_WAYLAND"] = "1"
    if not env.get("FINN_WIN_DEBUG"):
        env.setdefault("WINEDEBUG", "-all")

    # Prefer native Wayland driver (winewayland.drv) when WAYLAND_DISPLAY is present;
    # fall back to Xwayland only if WAYLAND_DISPLAY is absent or FINN_WIN_USE_X11=1.
    if env.get("WAYLAND_DISPLAY") and not env.get("FINN_WIN_USE_X11"):
        env.pop("DISPLAY", None)
    elif not env.get("DISPLAY") and os.path.isfile("/run/finn/xdisplay"):
        try:
            disp = Path("/run/finn/xdisplay").read_text(encoding="utf-8").strip()
            if disp:
                env["DISPLAY"] = disp
        except OSError:
            pass

    if os.path.isdir("/opt/hangover/usr/lib/aarch64-linux-gnu"):
        ho_lib = "/opt/hangover/usr/lib/aarch64-linux-gnu:/opt/hangover/usr/lib/aarch64-linux-gnu/wine"
        prev_ld = env.get("LD_LIBRARY_PATH", "")
        env["LD_LIBRARY_PATH"] = f"{ho_lib}:{prev_ld}" if prev_ld else ho_lib
        env.setdefault("WINEDLLPATH", "/opt/hangover/usr/lib/aarch64-linux-gnu/wine")

    overrides = []
    if not env.get("FINN_WIN_ALLOW_MONO"):
        overrides.append("mscoree,mshtml=")
    if rt.get("dxvk_path"):
        overrides.append("d3d9,d3d10core,d3d11,dxgi=n,b")
    if rt.get("vkd3d_path"):
        overrides.append("d3d12,d3d12core=n,b")
    if overrides:
        existing = env.get("WINEDLLOVERRIDES", "")
        joined = ";".join(overrides)
        env["WINEDLLOVERRIDES"] = f"{existing};{joined}" if existing else joined
    return env


def _install_dll_dir(src_dir: str, dst_dir: str) -> None:
    if not os.path.isdir(src_dir) or not os.path.isdir(dst_dir):
        return
    for dll in glob.glob(os.path.join(src_dir, "*.dll")):
        target = os.path.join(dst_dir, os.path.basename(dll))
        if not os.path.exists(target):
            try:
                os.symlink(dll, target)
            except OSError:
                shutil.copy2(dll, target)


def _wrap_cmd(rt: Dict[str, object], cmd: List[str]) -> List[str]:
    arch = str(rt["host_arch"])
    if arch not in ("x86_64", "amd64") and not rt.get("native_arm_wine") and rt.get("emulator_bin"):
        return [str(rt["emulator_bin"]), *cmd]
    return cmd


def init_prefix(rt: Dict[str, object], force: bool = False) -> int:
    if not rt["ready"]:
        print(
            f"error: Windows runtime unavailable on {rt['host_arch']} "
            f"(engine={rt['engine']}, emulator={rt['emulator_bin'] or 'none'})",
            file=sys.stderr,
        )
        return 1

    prefix = str(rt["prefix"])
    stamp = os.path.join(prefix, ".finn-win11-ready")
    if not force and os.path.isfile(stamp) and os.path.isfile(os.path.join(prefix, "system.reg")):
        return 0

    os.makedirs(prefix, exist_ok=True)
    env = _build_env(rt)
    wine_bin = str(rt["selected_bin"])

    # Initialize or update prefix silently without blocking on Mono/Gecko prompts
    init_env = dict(env)
    prev_ovr = init_env.get("WINEDLLOVERRIDES", "")
    init_env["WINEDLLOVERRIDES"] = f"{prev_ovr};mscoree,mshtml=" if prev_ovr else "mscoree,mshtml="
    try:
        subprocess.run(_wrap_cmd(rt, [wine_bin, "wineboot", "-u"]), env=init_env, check=False, timeout=45)
    except subprocess.TimeoutExpired:
        pass

    # Ensure modern visual style (aero.msstyles) is installed in the prefix
    theme_dst = os.path.join(prefix, "drive_c", "windows", "resources", "themes", "aero", "aero.msstyles")
    if not os.path.isfile(theme_dst):
        theme_candidates = [
            "/opt/hangover/usr/lib/wine/aarch64-windows/aero.msstyles",
            "/opt/hangover/usr/lib/wine/x86_64-windows/aero.msstyles",
            "/usr/lib/wine/x86_64-windows/aero.msstyles",
            "/usr/lib/wine/aarch64-windows/aero.msstyles",
            "/usr/lib64/wine/x86_64-windows/aero.msstyles",
        ]
        for cand in theme_candidates:
            if os.path.isfile(cand):
                os.makedirs(os.path.dirname(theme_dst), exist_ok=True)
                shutil.copy2(cand, theme_dst)
                break

    # Apply Windows 11 Pro + Modern Fluent/Aero Theme + ClearType + Wayland driver registry keys
    reg_path = os.path.join(prefix, ".finn-win11.reg")
    Path(reg_path).write_text(WIN11_REG, encoding="utf-8")
    try:
        subprocess.run(_wrap_cmd(rt, [wine_bin, "regedit", "/S", reg_path]), env=init_env, check=False, timeout=20)
    except subprocess.TimeoutExpired:
        pass
    finally:
        try:
            os.remove(reg_path)
        except OSError:
            pass

    # Link DXVK / VKD3D-Proton DLLs into system32 when installed on the host
    sys32 = os.path.join(prefix, "drive_c", "windows", "system32")
    if rt.get("dxvk_path"):
        _install_dll_dir(str(rt["dxvk_path"]), sys32)
    if rt.get("vkd3d_path"):
        _install_dll_dir(str(rt["vkd3d_path"]), sys32)

    Path(stamp).write_text("win11\n", encoding="utf-8")
    return 0


def launch_target(rt: Dict[str, object], target: str, extra_args: List[str]) -> int:
    if not rt["ready"]:
        print(
            f"error: Windows 11 compatibility runtime unavailable on {rt['host_arch']}. "
            "Install wine (and proton/dxvk for Direct3D) on x86_64, or wine + box64/fex-emu on aarch64.",
            file=sys.stderr,
        )
        return 1

    # Allow bare Windows system executables (notepad.exe, winver.exe, winecfg, etc.)
    # and Windows drive paths (C:\...) to pass directly to Wine; otherwise require a real host file.
    is_win_builtin = (
        "/" not in target
        and "\\" not in target
        and not os.path.exists(target)
    ) or (len(target) >= 3 and target[1:3] in (":\\", ":/"))

    if is_win_builtin:
        resolved_target = target
    else:
        resolved_target = os.path.abspath(target)
        if not os.path.isfile(resolved_target):
            print(f"error: file not found: {resolved_target}", file=sys.stderr)
            return 1

    rc = init_prefix(rt, force=False)
    if rc != 0:
        return rc

    env = _build_env(rt)
    wine_bin = str(rt["selected_bin"])
    low = resolved_target.lower()
    if low.endswith(".msi"):
        cmd = [wine_bin, "msiexec", "/i", resolved_target, *extra_args]
    elif low.endswith(".bat") or low.endswith(".cmd"):
        cmd = [wine_bin, "cmd", "/c", resolved_target, *extra_args]
    else:
        cmd = [wine_bin, resolved_target, *extra_args]

    cwd = None if is_win_builtin else (os.path.dirname(resolved_target) or None)
    proc = subprocess.run(_wrap_cmd(rt, cmd), env=env, cwd=cwd)
    return proc.returncode


_WINDOWS_PACKAGE_KINDS = {
    ".msi": "MSI",
    ".exe": "EXE",
    ".msix": "MSIX",
    ".bat": "BAT",
    ".cmd": "CMD",
}

_HEX_DIGITS = frozenset("0123456789abcdefABCDEF")


def _windows_package_kind(path: str) -> str:
    # Mirrors finn::compat::detect_windows_package_kind (src/compat/msi_installer.cpp).
    return _WINDOWS_PACKAGE_KINDS.get(os.path.splitext(path or "")[1].lower(), "Unknown")


def _is_product_code(target: str) -> bool:
    # Mirrors finn::compat::is_product_code (src/compat/msi_installer.cpp): the
    # braced {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX} and 32-hex forms.
    g = target
    if len(g) == 38 and g.startswith("{") and g.endswith("}"):
        g = g[1:-1]
    if len(g) == 32:
        return all(ch in _HEX_DIGITS for ch in g)
    if len(g) == 36:
        if g[8] != "-" or g[13] != "-" or g[18] != "-" or g[23] != "-":
            return False
        return all(ch in _HEX_DIGITS for i, ch in enumerate(g) if i not in (8, 13, 18, 23))
    return False


def _exe_silent_guess(name_lower: str) -> Tuple[List[str], str]:
    # Mirrors exe_silent_guess in src/compat/msi_installer.cpp: guesses from the
    # file name only; the note stays honest that other installers are unknown.
    if "nsis" in name_lower or name_lower.endswith("_setup.exe"):
        return ["/S"], (
            "NSIS detected from the filename; its silent switch is /S - verify the installer honors it"
        )
    if "inno" in name_lower:
        return ["/VERYSILENT", "/NORESTART"], (
            "Inno Setup detected from the filename; its silent switch is /VERYSILENT /NORESTART - "
            "verify the installer honors it"
        )
    return [], ""


def _build_install_plan(
    path: str,
    prefix: str = "",
    silent: bool = True,
    log_path: str = "",
    extra_args: Optional[List[str]] = None,
) -> Dict[str, object]:
    # Mirror of finn::compat::build_install_plan (src/compat/msi_installer.cpp):
    # same kind detection, argv and honest notes. Data only; nothing runs here.
    extras = list(extra_args or [])
    kind = _windows_package_kind(path)
    plan: Dict[str, object] = {
        "kind": kind,
        "argv": [],
        "env": [],
        "ok": False,
        "silent": silent,
        "error": "",
        "notes": [],
    }
    if prefix:
        plan["env"].append(("WINEPREFIX", prefix))

    if kind == "MSI":
        if not os.path.isfile(path):
            plan["error"] = f"installer file not found: {path}"
        else:
            plan["argv"] = ["msiexec", "/i", path]
            if silent:
                plan["argv"] += ["/qn", "/norestart"]
            if log_path:
                plan["argv"] += ["/L*v", log_path]
            plan["argv"] += extras
            if prefix:
                # MSI has no universal prefix property; the plan does not guess one.
                plan["notes"].append(
                    f"prefix '{prefix}' has no universal MSI property; the plan does not guess one "
                    "(verify INSTALLDIR/TARGETDIR)"
                )
            plan["ok"] = True
    elif kind == "EXE":
        if not os.path.isfile(path):
            plan["error"] = f"installer file not found: {path}"
        else:
            plan["argv"] = [path]
            if silent:
                base = os.path.basename(path)
                switches, note = _exe_silent_guess(base.lower())
                if switches:
                    plan["argv"] += switches
                    plan["notes"].append(note)
                else:
                    plan["notes"].append(
                        "silent install requested but no silent switch was identified "
                        f"for '{base}'; the installer's own switch is unknown"
                    )
            plan["argv"] += extras
            plan["ok"] = True
    elif kind in ("BAT", "CMD"):
        if not os.path.isfile(path):
            plan["error"] = f"installer file not found: {path}"
        else:
            plan["argv"] = ["cmd", "/c", path] + extras
            plan["ok"] = True
    elif kind == "MSIX":
        plan["error"] = (
            "MSIX packages cannot be installed by Wine here: AppX/App Installer is not "
            "implemented in FinnOS; install it natively or use Finn Store"
        )
    else:
        plan["error"] = (
            f"unrecognized package extension for '{path}' "
            "(expected .msi/.exe/.msix/.bat/.cmd)"
        )
    return plan


def _build_uninstall_plan(
    target: str,
    prefix: str = "",
    silent: bool = True,
    log_path: str = "",
    extra_args: Optional[List[str]] = None,
) -> Dict[str, object]:
    # Mirror of finn::compat::build_uninstall_plan (src/compat/msi_installer.cpp).
    extras = list(extra_args or [])
    plan: Dict[str, object] = {
        "kind": _windows_package_kind(target),
        "argv": [],
        "env": [],
        "ok": False,
        "silent": silent,
        "error": "",
        "notes": [],
    }
    if prefix:
        plan["env"].append(("WINEPREFIX", prefix))
    if not target:
        plan["error"] = "nothing to uninstall: no target given"
        return plan
    if _is_product_code(target):
        plan["kind"] = "MSI"
        plan["argv"] = ["msiexec", "/x", target]
        if silent:
            plan["argv"].append("/qn")
        plan["argv"].append("/norestart")
        if log_path:
            plan["argv"] += ["/L*v", log_path]
        plan["argv"] += extras
        plan["ok"] = True
        return plan
    kind = str(plan["kind"])
    if kind == "MSI":
        if not os.path.isfile(target):
            plan["error"] = f"msi package not found: {target}"
        else:
            plan["argv"] = ["msiexec", "/x", target, "/qn", "/norestart"]
            if log_path:
                plan["argv"] += ["/L*v", log_path]
            plan["argv"] += extras
            plan["ok"] = True
    elif kind in ("EXE", "BAT", "CMD", "MSIX"):
        plan["error"] = (
            f"cannot uninstall a {kind} package through msiexec here; "
            "pass an .msi path or an MSI product code"
        )
    else:
        plan["error"] = (
            f"nothing sensible to uninstall: '{target}' is not an .msi path "
            "or an MSI product code"
        )
    return plan


def _inspect_pe(path: str) -> Dict[str, object]:
    # Mirrors finn::compat::inspect_pe_file (src/compat/wine_runner.cpp).
    info: Dict[str, object] = {
        "valid": False,
        "arch": "Unknown",
        "is_gui": False,
        "is_console": False,
        "is_dotnet": False,
        "error": "",
    }
    try:
        with open(path, "rb") as f:
            head = f.read(64)
    except OSError:
        info["error"] = "cannot open file"
        return info
    if len(head) < 64:
        info["error"] = "file too short for DOS header"
        return info
    if head[:2] != b"MZ":
        info["error"] = "missing MZ signature"
        return info
    pe_off = int.from_bytes(head[60:64], "little")
    try:
        with open(path, "rb") as f:
            f.seek(0)
            # The C++ reader extends its buffer to pe_off+512 when the MZ
            # signature is present (inspect_pe_file, wine_runner.cpp); mirror it.
            buf = f.read(min(pe_off + 512, 1024 * 1024))
    except OSError:
        buf = head
    if pe_off > len(buf) or len(buf) - pe_off < 24:
        info["error"] = "PE header offset out of bounds"
        return info
    if buf[pe_off:pe_off + 4] != b"PE\x00\x00":
        info["error"] = "missing PE signature"
        return info

    coff = pe_off + 4
    machine = int.from_bytes(buf[coff:coff + 2], "little")
    info["arch"] = {
        0x014C: "x86 (32-bit)",
        0x8664: "x86_64 (64-bit)",
        0xAA64: "ARM64",
    }.get(machine, "Unknown")

    opt = coff + 20
    if int.from_bytes(buf[coff + 16:coff + 18], "little") >= 70 and len(buf) >= opt + 70:
        magic = int.from_bytes(buf[opt:opt + 2], "little")
        subsystem = int.from_bytes(buf[opt + 68:opt + 70], "little")
        info["is_gui"] = subsystem == 2
        info["is_console"] = subsystem == 3
        # CLR Runtime Header is DataDirectory[14]: offset 208 (PE32) or 224 (PE32+).
        rva_count_off = opt + 108 if magic == 0x020B else opt + 92
        clr_dir_off = opt + 224 if magic == 0x020B else opt + 208
        if len(buf) >= rva_count_off + 4 and len(buf) >= clr_dir_off + 8:
            num_rvas = int.from_bytes(buf[rva_count_off:rva_count_off + 4], "little")
            if num_rvas > 14 and int.from_bytes(buf[clr_dir_off:clr_dir_off + 4], "little") != 0:
                info["is_dotnet"] = True
    info["valid"] = True
    return info


def _first_positional(rest: List[str]) -> Optional[str]:
    for a in rest:
        if not a.startswith("-"):
            return a
    return None


def _parse_install_args(rest: List[str]) -> Tuple[Optional[Dict[str, object]], Optional[str]]:
    opts: Dict[str, object] = {
        "path": None,
        "prefix": "",
        "mode": "silent",
        "log": "",
        "extras": [],
    }
    i = 0
    while i < len(rest):
        a = rest[i]
        if a in ("--silent", "--interactive"):
            opts["mode"] = a[2:]
        elif a.startswith("--prefix="):
            opts["prefix"] = a[len("--prefix="):]
        elif a == "--prefix":
            i += 1
            if i >= len(rest):
                return None, "install: --prefix requires a value"
            opts["prefix"] = rest[i]
        elif a.startswith("--log="):
            opts["log"] = a[len("--log="):]
        elif a == "--log":
            i += 1
            if i >= len(rest):
                return None, "install: --log requires a value"
            opts["log"] = rest[i]
        elif a.startswith("-") and a != "-":
            return None, f"install: unknown option '{a}'"
        elif opts["path"] is None:
            opts["path"] = a
        else:
            opts["extras"].append(a)
        i += 1
    if not opts["path"]:
        return None, "install: a target package path is required"
    return opts, None


def _parse_uninstall_args(rest: List[str]) -> Tuple[Optional[Dict[str, object]], Optional[str]]:
    opts: Dict[str, object] = {
        "target": None,
        "prefix": "",
        "mode": "silent",
        "log": "",
    }
    i = 0
    while i < len(rest):
        a = rest[i]
        if a in ("--silent", "--interactive"):
            opts["mode"] = a[2:]
        elif a.startswith("--prefix="):
            opts["prefix"] = a[len("--prefix="):]
        elif a == "--prefix":
            i += 1
            if i >= len(rest):
                return None, "uninstall: --prefix requires a value"
            opts["prefix"] = rest[i]
        elif a.startswith("--log="):
            opts["log"] = a[len("--log="):]
        elif a == "--log":
            i += 1
            if i >= len(rest):
                return None, "uninstall: --log requires a value"
            opts["log"] = rest[i]
        elif a.startswith("-") and a != "-":
            return None, f"uninstall: unknown option '{a}'"
        elif opts["target"] is None:
            opts["target"] = a
        else:
            return None, f"uninstall: unexpected argument '{a}'"
        i += 1
    if not opts["target"]:
        return None, "uninstall: a target is required (an .msi path or an MSI product code)"
    return opts, None


def _cmd_install(rt: Dict[str, object], rest: List[str], json_out: bool) -> int:
    opts, err = _parse_install_args(rest)
    if err:
        print(f"error: {err}", file=sys.stderr)
        return 2
    plan = _build_install_plan(
        str(opts["path"]),
        prefix=str(opts["prefix"]),
        silent=str(opts["mode"]) == "silent",
        log_path=str(opts["log"]),
        extra_args=[str(a) for a in opts["extras"]],
    )
    result: Dict[str, object] = {
        "verb": "install",
        "kind": plan["kind"],
        "ok": plan["ok"],
        "argv": plan["argv"],
        "env": dict(plan["env"]),
        "silent": plan["silent"],
        "error": plan["error"],
        "notes": plan["notes"],
    }
    if not plan["ok"]:
        if json_out:
            print(json.dumps(result, indent=2, sort_keys=True))
        else:
            print(f"error: {plan['error']}", file=sys.stderr)
        return 1

    if not json_out:
        for note in plan["notes"]:
            print(f"note: {note}", file=sys.stderr)

    rc = init_prefix(rt, force=False)
    if rc != 0:
        result["returncode"] = rc
        if json_out:
            print(json.dumps(result, indent=2, sort_keys=True))
        return rc

    wine_bin = rt.get("selected_bin")
    if not wine_bin:
        result["returncode"] = 1
        if json_out:
            print(json.dumps(result, indent=2, sort_keys=True))
        else:
            print("error: Windows runtime is not available", file=sys.stderr)
        return 1

    env = _build_env(rt)
    env.update(dict(plan["env"]))
    proc = subprocess.run(_wrap_cmd(rt, [str(wine_bin), *plan["argv"]]), env=env)
    result["returncode"] = proc.returncode
    if json_out:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(f"install: {plan['kind']} {str(opts['path'])} exit {proc.returncode}")
    return proc.returncode


