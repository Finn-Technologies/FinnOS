def _cmd_detect(rest: List[str], json_out: bool) -> int:
    target = _first_positional(rest)
    if not target:
        print("error: detect: a target package path is required", file=sys.stderr)
        return 2
    kind = _windows_package_kind(target)
    if json_out:
        print(json.dumps({"kind": kind, "path": target}, indent=2, sort_keys=True))
    else:
        print(kind)
    return 0


def _cmd_diagnose(rt: Dict[str, object], rest: List[str], json_out: bool) -> int:
    target = _first_positional(rest)
    if not target:
        print("error: diagnose: a target package path is required", file=sys.stderr)
        return 2
    kind = _windows_package_kind(target)
    pe = _inspect_pe(target)
    unsupported: List[str] = []
    if not rt["ready"]:
        unsupported.append(
            "Windows runtime unavailable: no Proton/Wine or aarch64 translator (box64/fex-emu) found on this host"
        )
    if kind == "MSIX":
        unsupported.append(
            "MSIX: AppX/App Installer is not implemented in FinnOS; install it natively or use Finn Store"
        )
    if kind == "EXE" and not pe["valid"]:
        unsupported.append(f"PE inspection failed: {pe['error']}")

    diag = {
        "path": target,
        "kind": kind,
        "pe": pe,
        "runtime": {
            "engine": rt["engine"],
            "host_arch": rt["host_arch"],
            "ready": rt["ready"],
            "selected_bin": rt["selected_bin"],
        },
        "prefix": {
            "path": rt["prefix"],
            "initialized": rt["prefix_initialized"],
            "win11_configured": rt["win11_configured"],
        },
        "unsupported": unsupported,
    }
    if json_out:
        print(json.dumps(diag, indent=2, sort_keys=True))
    else:
        pe_text = (
            f"valid - arch={pe['arch']}, subsystem={'GUI' if pe['is_gui'] else ('Console' if pe['is_console'] else 'other')}, "
            f"dotnet={'yes' if pe['is_dotnet'] else 'no'}"
        ) if pe["valid"] else f"invalid - {pe['error']}"
        print(f"path:             {target}")
        print(f"kind:             {kind}")
        print(f"pe:               {pe_text}")
        print(f"runtime:          engine={rt['engine']}, host_arch={rt['host_arch']}, ready={rt['ready']}")
        print(f"prefix:           {rt['prefix']}, initialized={rt['prefix_initialized']}, win11={rt['win11_configured']}")
        print(f"unsupported:      {'; '.join(unsupported) if unsupported else '(none)'}")
    return 0


def main(argv: Optional[List[str]] = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    # Lift --json out before parsing: the REMAINDER positional can swallow it,
    # and the verb parsers below expect clean verb arguments.
    json_out = "--json" in argv
    argv = [a for a in argv if a != "--json"]

    p = argparse.ArgumentParser(
        prog="finn-win",
        description="FinnOS Windows 11 compatibility runner (Proton / Wine + DXVK/VKD3D + Wayland, "
                    "MSI install/uninstall, package detect/diagnose)",
    )
    p.add_argument(
        "verb",
        nargs="?",
        default=None,
        help="status | init | install <path> | uninstall <msi-or-product-code> | "
             "detect <path> | diagnose <path> | path/to/app.exe|.msi",
    )
    p.add_argument(
        "args",
        nargs=argparse.REMAINDER,
        help="verb arguments (options, or arguments forwarded to the Windows app)",
    )
    ns = p.parse_args(argv)

    rt = _detect_runtime()
    verb = ns.verb
    rest = list(ns.args)

    if verb in (None, "status"):
        if json_out:
            print(json.dumps(rt, indent=2, sort_keys=True))
        else:
            print(
                f"finn-win ({rt['host_arch']})\n"
                f"  engine:  {rt['engine']} ({rt['selected_bin'] or 'not installed'})\n"
                f"  prefix:  {rt['prefix']} (win11={rt['win11_configured']})\n"
                f"  dxvk:    {rt['dxvk_path'] or 'not installed'}\n"
                f"  vkd3d:   {rt['vkd3d_path'] or 'not installed'}\n"
                f"  ready:   {rt['ready']}"
            )
        return 0

    if verb == "init":
        return init_prefix(rt, force=True)
    if verb == "install":
        return _cmd_install(rt, rest, json_out)
    if verb == "uninstall":
        return _cmd_uninstall(rt, rest, json_out)
    if verb == "detect":
        return _cmd_detect(rest, json_out)
    if verb == "diagnose":
        return _cmd_diagnose(rt, rest, json_out)
    return launch_target(rt, verb, rest)


if __name__ == "__main__":
    sys.exit(main())
