[Unit]
Description=FinnOS session broker (finn-session)
Documentation=man:finn-session(1)
After=finn-comp.service user-runtime-dir@1000.service
Wants=finn-comp.service user-runtime-dir@1000.service
OnFailure=finn-failure.service

[Service]
Type=simple
User=finn
Group=finn
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=/run/finn/wayland-0
Environment=FINN_ICON_DIR=/usr/share/finn/icons
ExecStart=/usr/local/bin/finn-session
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=graphical.target
