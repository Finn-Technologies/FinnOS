[Unit]
Description=FinnOS Shell (finn-shell)
Documentation=man:finn-shell(1)
After=finn-comp.service finn-session.service
Wants=finn-comp.service finn-session.service
OnFailure=finn-failure.service

[Service]
Type=simple
User=finn
Group=finn
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=/run/finn/wayland-0
Environment=FINN_ICON_DIR=/usr/share/finn/icons
Environment=QT_QPA_PLATFORM=wayland
Environment=QT_QPA_PLATFORMTHEME=finn
Environment=QT_STYLE_OVERRIDE=finn
Environment=XCURSOR_THEME=finn-light
Environment=XCURSOR_SIZE=24
ExecStart=/usr/local/bin/finn-shell
Restart=on-failure
RestartSec=2
# NoNewPrivileges is omitted so su/unix_chkpwd can verify passwords on lock.

[Install]
WantedBy=graphical.target
