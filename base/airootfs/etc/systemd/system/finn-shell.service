[Unit]
Description=FinnOS Shell (finn-shell)
Documentation=man:finn-shell(1)
After=finn-comp.service finn-session.service
Wants=finn-comp.service finn-session.service
OnFailure=finn-failure.service

[Service]
Type=simple
User=finn
Group=finn
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=/run/finn/wayland-0
Environment=FINN_ICON_DIR=/usr/share/finn/icons
ExecStart=/usr/local/bin/finn-shell
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=graphical.target
