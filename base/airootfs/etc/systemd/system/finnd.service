[Unit]
Description=FinnOS Control Plane (finnd)
Documentation=man:finnd(1)
# The control plane is useful even while the compositor restarts, so it is
# deliberately not ordered against finn-comp.
After=systemd-user-sessions.service

[Service]
Type=simple
ExecStart=/usr/local/bin/finnd

# This daemon is root-equivalent authority over the running system: it can
# move the pointer, read the framebuffer, start apps and power the machine
# off. It is therefore:
#   - socket-activated only (no TCP listener, ever)
#   - bound to /run/finn/control.sock, mode 0660, root and group finn
#   - authenticated per connection with SO_PEERCRED
#   - audited to /var/log/finn/control.log
# Remote control is an explicit decision by the user, not a default. This is
# the same intent as the zero-AI-by-default policy.
#
# It runs in root's own group on purpose. The group that matters is the
# one on the socket, and the daemon sets that itself: systemd takes
# CAP_SETUID away from a service whose group it had to change, and the
# control plane is hardened with NoNewPrivileges besides. An app is
# started by systemd, as the user, in its own transient unit — so the
# daemon never has to change a uid itself.
User=root
Group=root

Restart=always
RestartSec=1
StateDirectory=finn
LogsDirectory=finn

NoNewPrivileges=yes
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native

[Install]
WantedBy=graphical.target
