[Unit]
Description=FinnOS Compositor (finn-comp)
Documentation=man:finn-comp(1)
# The compositor is the display: it must come up before getty and the shell.
# It opens DRM and evdev through seatd, so the seat daemon has to be there.
Wants=seatd.service
After=systemd-user-sessions.service seatd.service
Before=getty@tty1.service display-manager.service
Conflicts=getty@tty1.service
OnFailure=finn-failure.service
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/finn-comp

# DRM master and evdev are opened through seatd, not directly. The display
# socket lives in /run/finn so that the apps, which run as finn, can reach it;
# root's $XDG_RUNTIME_DIR is private and would be the wrong place.
User=root
Group=finn
SupplementaryGroups=video render input seat audio
Environment=XDG_RUNTIME_DIR=/run/finn
Environment=WLR_BACKENDS=drm
Environment=LIBSEAT_BACKEND=seatd

StandardOutput=journal
StandardError=journal
StandardInput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

Restart=on-failure
RestartSec=2
WatchdogSec=15
IgnoreSIGPIPE=yes

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=graphical.target
