post_upgrade() {
    if usr/bin/pacman-key -l >/dev/null 2>&1; then
        usr/bin/pacman-key --populate finnos
    else
        echo " >>> Run \`pacman-key --init\` before \`pacman-key --populate finnos\`."
    fi
}

post_install() {
    if [ -x usr/bin/pacman-key ]; then
        post_upgrade
    fi
}
