# finnos-compose — the display server, the app runtime and the session.
#
# One package because they are one session: finn-comp owns the display,
# finn-session launches apps as the user, and finn-shell is a client of both.
# The runtime library, the icons, the wallpapers, the registry and the Fixel
# Display face travel with them for the same reason: a shell without its
# assets draws empty squares.
#
#   FINNOS_SRC=/path/to/finnos makepkg -f
#
# Binaries install under /usr/local, which is the tree's convention:
# src/comp/Makefile's PREFIX, the ExecStart in finn-comp.service and this
# package all name /usr/local/bin/finn-comp. Moving it means changing the
# unit and the Makefiles in the same commit.

pkgname=finnos-compose
pkgver=0.2.0
pkgrel=1
pkgdesc='The FinnOS compositor, app runtime, session and shell'
arch=('x86_64' 'aarch64')
url='https://finnos.org'
license=('MIT')
depends=('glibc' 'wlroots0.20' 'systemd-libs' 'libdrm' 'libinput' 'libxkbcommon'
         'wayland' 'freetype2' 'fontconfig' 'libwebp' 'mesa' 'libglvnd' 'seatd')
makedepends=('base-devel' 'pkgconf' 'wayland')
options=('!strip')

_src="${FINNOS_SRC:-$(realpath "$startdir/../../..")}"

build() {
  make -C "$_src" -j"$(nproc)"
}

package() {
  make -C "$_src" install DESTDIR="$pkgdir" PREFIX=/usr/local

  install -Dm644 "$_src/base/finn-comp.service" \
    "$pkgdir/usr/lib/systemd/system/finn-comp.service"
  install -Dm644 "$_src/base/finn-session.service" \
    "$pkgdir/usr/lib/systemd/system/finn-session.service"
  install -Dm644 "$_src/base/finn-shell.service" \
    "$pkgdir/usr/lib/systemd/system/finn-shell.service"
  install -Dm644 "$_src/base/finn-wallpaper.service" \
    "$pkgdir/usr/lib/systemd/system/finn-wallpaper.service"
  install -Dm644 "$_src/base/finn-failure.service" \
    "$pkgdir/usr/lib/systemd/system/finn-failure.service"
  install -Dm644 "$_src/base/finn-tmpfiles.conf" \
    "$pkgdir/usr/lib/tmpfiles.d/finn.conf"
  install -Dm644 "$_src/base/airootfs/usr/lib/sysusers.d/finn.conf" \
    "$pkgdir/usr/lib/sysusers.d/finn.conf"
}
