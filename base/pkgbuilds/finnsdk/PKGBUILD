# finnsdk — the .fui compiler and the control-plane client.
#
# The SDK has no dependencies on purpose (see sdk/pyproject.toml): a
# toolkit that needs a wheel to answer a question about a window is a
# toolkit nobody uses. That makes it a copy rather than a setuptools build:
# the package is sdk/finnsdk, and a .pth file puts it on the interpreter's
# path. Nothing is compiled and nothing is generated, so there is nothing
# for a build step to do.
#
# The two entry points keep their names: fuic is the compiler, finn-sdk is
# the client.
#
#   FINNOS_SRC=/path/to/finnos makepkg -f

pkgname=finnsdk
pkgver=0.1.0
pkgrel=1
pkgdesc='FinnSDK: the .fui compiler, the control-plane client and the app templates'
arch=('any')
url='https://finnos.org'
license=('MIT')
depends=('python')
_makedepends=('python')

_src="${FINNOS_SRC:-$(realpath "$startdir/../../..")}"

package() {
  local pydir
  pydir=$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')

  install -d "$pkgdir/usr/lib/finnsdk"
  cp -a "$_src/sdk/finnsdk/." "$pkgdir/usr/lib/finnsdk/"
  find "$pkgdir/usr/lib/finnsdk" -name '__pycache__' -type d -prune -exec rm -rf {} +
  chmod -R a+rX "$pkgdir/usr/lib/finnsdk"

  install -Dm644 /dev/null "$pkgdir$pydir/finnsdk.pth"
  printf '/usr/lib/finnsdk\n' > "$pkgdir$pydir/finnsdk.pth"

  install -Dm755 "$_src/sdk/bin/fuic" "$pkgdir/usr/bin/fuic"
  install -Dm755 "$_src/sdk/bin/finn-sdk" "$pkgdir/usr/bin/finn-sdk"

  install -Dm644 "$_src/sdk/README.md" "$pkgdir/usr/share/doc/finnsdk/README.md"
  install -Dm644 "$_src/sdk/finnsdk/fuic/FORMAT.md" "$pkgdir/usr/share/doc/finnsdk/FORMAT.md"
  install -d "$pkgdir/usr/share/finnsdk/templates"
  install -m644 "$_src"/sdk/templates/* "$pkgdir/usr/share/finnsdk/templates/"
}
