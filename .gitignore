# Build output. Nothing compiled is ever committed: the tree is sources.
*.o
*.a
*.so
/src/comp/finn-comp
/src/comp/build/
/src/session/finn-session
/src/shell/finn-shell
/src/ui/libfinnui.a
/src/ui/build/
/apps/files/finn-files
/apps/settings/finn-settings
/sdk/template/finn-counter
/tests/rewrite/test_app_registry
*.dSYM/

# Captures. A session's PPM and PNG files are artefacts, not the OS.
*.ppm
*.pgm
/.finnos-*.png
/.finnos-*.bmp

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
dist/
build/

# Editors and operating systems
.DS_Store
*.swp
*~
.idea/
.vscode/

# The agent's local state (taste files and scratch data), not the tree.
.commandcode/
