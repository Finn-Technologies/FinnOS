// FinnOS Boot Screen (Figma 1:2).
// Drawn by src/compositor/finnboot.c.

screen Boot {
  target: Desktop (primary)
  background: #000000

  Column(placement: center, gap: 65px, align: center) {
    Icon(id: mark, src: start.svg, size: 65px, ink: #FFFFFF)
    ProgressBar(id: progress, width: 195px, height: 6.5px,
                radius: token.r_pill, track: #666C6C6C, fill: #FFFFFF)
  }
}
