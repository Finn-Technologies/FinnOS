// FinnOS Setup — Light & Dark (Figma 2:14 & 7:10).
// Drawn by src/compositor/finnsetup.c.

screen Setup {
  target: Desktop (primary)

  Row(padding: 39px, gap: 78px, align: center) {
    HeroCard(id: hero, src: setup.webp, width: 753px, height: 1002px,
             radius: token.r_hero)

    Column(gap: 32px) {
      Row(gap: 8px, align: center) {
        Icon(id: mark, src: start.svg, size: 31px, ink: token.ink)
        Text("FinnOS", style: token.title, ink: token.ink)
      }

      Column(gap: 6px) {
        Text("Welcome!", style: token.title, ink: token.ink)
        Text("Let's start configuring your device.", style: token.title, ink: token.ink)
      }

      Pill(id: language, width: 193px, height: 41.5px, radius: token.r_pill,
           icon_left: language.svg, icon_right: chevron_down.svg,
           text: "English (US)", on_tap: setup.cycle_language)

      Row(gap: 19.5px, align: center) {
        CircleButton(id: accessibility, size: 41.5px, icon: accessibility.svg,
                     on_tap: appearance.toggle)
        Pill(id: start, width: 104px, height: 41.5px, radius: token.r_pill,
             fill: token.on, ink: token.knob, text: "Start",
             icon_right: chevron_right.svg, on_tap: setup.complete)
      }
    }
  }
}
