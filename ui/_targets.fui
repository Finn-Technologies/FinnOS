// FinnOS Adaptive Targets v1
//
// Write once, scale everywhere. The compositor selects a target at boot
// and on hotplug or fold.
//
// What is honest here: the shell that exists today is a dock, a Control
// Center, a clock page and a Start Menu. There is no window manager, so
// the window area in these targets is a design intent and not a feature —
// see docs/architecture.md, "What is not here yet". Only Desktop is
// implemented; the other three are the language's shape on other kinds of
// machine.

target Desktop {
  viewport: min 1024x600, base 1920x1080
  density: 1.0x, type_scale: 1.0
  // A pointer and nothing else: the compositor reads no keyboard yet.
  input: pointer
  nav: shell_surfaces + floating_dock
  shell: {
    topbar: none,          // the tray holds the status, in the dock
    dock: bottom_center_floating,
    windows: none_yet      // no window manager: see docs/architecture.md
  }
  focus: mouse_hover
}

target Mobile {
  viewport: 360-430w x 700-950h, portrait
  density: 2.0-3.0x, type_scale: 1.0
  input: touch + gestures
  nav: bottom_nav_64h + swipe_up_launcher
  shell: {
    dock: bottom_nav_fullwidth,
    windows: fullscreen_stack
  }
  focus: tap, swipe regions
}

target MobileXL { // foldable + tablet
  viewport: 600-1366w, folded: 360w / unfolded: 800w+
  density: 1.5-2.0x, type_scale: 1.1
  input: touch + optional pointer
  nav: split_view_max2 + floating_panels
  shell: {
    dock: left_rail_or_bottom_floating,
    windows: split_primary_secondary
  }
  focus: tap, drag_splitter
  fold_rule: on_fold_change -> preserve_focused_surface, reflow <150ms
}

target TV {
  viewport: 1920x1080, 10foot
  density: 1.0x, type_scale: 1.5, min_text: 32sp
  input: dpad + remote, no pointer
  nav: launcher_row_bottom_96h
  shell: {
    dock: none, // replaced by launcher_row
    windows: fullscreen_single
  }
  focus: spatial_nav_graph, ring: 3px #7AB8FF, overscan: 5%
}
