// FinnOS Theme Tokens — the shell's tokens.
//
// This file is the design system's statement of intent. The compositor
// carries the same palette in src/compositor/finndraw.c and the same
// timings in src/compositor/finnmotion.h. The C is the truth; this file
// is kept in step with it by hand, which is a debt the compiler will
// eventually pay.
//
// A colour is one name with two halves, the light one and the dark one,
// because the appearance switch is a property of the whole theme and
// never of a single surface. Everything else is declared once.

theme FinnTokens {
  // ---- the palette ----------------------------------------------------
  // Bone and ink. The chrome is bone; the text on it is ink.

  color: bone_light #FFFFFF, bone_dark #23262E
  color: tile_light #FFFFFF, tile_dark #2F333C
  color: tile_on_light #D3E6FF, tile_on_dark #2B4A78
  color: hair_light #1A000000, hair_dark #1AFFFFFF

  color: ink_light #000000, ink_dark #F4F0E8
  color: mute_light #969696, mute_dark #8B9099
  color: dim_light #5D5C5C, dim_dark #A9A59E

  // The family accent is the same in both appearances: it is the brand's
  // colour, not the appearance's.
  color: accent_light #006FFF, accent_dark #006FFF

  color: track_light #40000000, track_dark #3B4048
  color: knob_light #FFFFFF, knob_dark #EDE9E1

  // `on` and `fill` are the accent and the track at full strength.
  color: on_light #006FFF, on_dark #0A84FF
  color: fill_light #FFFFFF, fill_dark #EDE9E1

  // The tint of the frosted chrome: near-white in the light appearance,
  // and the deep bone in the dark one, where frosted has to mean darkened
  // rather than brightened.
  color: glass_light #FFFFFF, glass_dark #23262E

  // ---- the radii ------------------------------------------------------
  // A surface's radius is a fraction of its smallest dimension.

  radius: r_bubble 10.4    // the dock's pills (ref 8)
  radius: r_panel 10.4     // the Control Center and Start Menu (ref 8)
  radius: r_tile 5.37      // a status tile inside Control Center (ref 4.14)
  radius: r_note 10.4      // a notification card or menu card (ref 8)
  radius: r_card 10.4      // the Start Menu and Window panel (ref 8)
  radius: r_app 7.67       // an app's chip in the dock / Start Menu (ref 5.91)
  radius: r_hero 39.0      // the Setup hero card (ref 30)
  radius: r_pill 999       // a slider row or action pill: half its height

  // ---- the type -------------------------------------------------------
  // One family, one weight. Hierarchy comes from size and from ink
  // against dim, never from a heavier cut of the face. Four weights ship;
  // the shell loads one of them.

  font: family "Fixel Display", weights [Regular 400, Medium 500, SemiBold 600, Bold 700]
    files: assets/fonts/FixelDisplay/*.otf, fallback: [DejaVu Sans, sans-serif]
  type: time 34/40 "Fixel Display" 400
  type: title 17/22 "Fixel Display" 400
  type: clock 18/22 "Fixel Display" 400
  type: label 12/16 "Fixel Display" 400
  type: label_sm 11/15 "Fixel Display" 400
  type: detail 10/14 "Fixel Display" 400
  type: micro 9/12 "Fixel Display" 400

  // ---- the material ---------------------------------------------------
  // The glass is the blurred wallpaper brought toward bone. A tile over a
  // panel is a second pass, and it compounds: 0.65 + 0.35 x 0.57 = 0.85.
  // There are no shadows: the reference's edges are a hard one-pixel step.

  weight: glass_panel 0.65, glass_tile 0.85, glass_well 0.53
  weight: surface_scale 0.92

  // ---- the wallpaper --------------------------------------------------

  color: wp_blue #006FFF, wp_light #EDF4FD
  gradient: wallpaper_desktop linear(180deg, #EDF4FD 0%, #C9E0FA 50%, #76AEEB 100%)
  effect: wallpaper_flute repeating-x(lines, 1px rgba(255,255,255,0.18) every 8px)

  // ---- the motion -----------------------------------------------------
  // One copy of the shell's timings, and they are the ones in
  // src/compositor/finnmotion.h. A surface takes longer to arrive than to
  // leave, and the pointer's answer is quicker than the pointer's
  // withdrawal.

  motion: surface_open 280ms out_back
  motion: surface_close 180ms in_out
  motion: scrim_in 200ms out
  motion: scrim_out 140ms in_out
  motion: hover_in 110ms out
  motion: hover_out 200ms out
  motion: press_in 80ms out
  motion: press_out 180ms out
  motion: fill 200ms out
  motion: grid_cell 200ms out
  motion: grid_step 22ms linear
  motion: grid_delay 60ms linear
  motion: clock_tick 260ms linear
  motion: note 220ms out
  motion: theme 360ms in_out

  // The pointer's wash: a hint when the pointer arrives, a confirmation
  // when it is pressed.
  weight: wash_hover 0.055, wash_press 0.090

  // ---- the setup hero -------------------------------------------------

  gradient: hero_beam diagonal(#0A1628 0%, #1A4D9E 45%, #7AB8FF 55%, #0A1628 100%)

  // ---- the type scale on a television ---------------------------------
  // A television is read from across a room, so the same body text is
  // larger there. The same reasoning sizes a dock in points rather than
  // in pixels.

  tv_type_scale: 1.5, min_tv 32sp
}
