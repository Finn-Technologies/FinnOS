// FinnOS Theme Tokens — the shell's tokens.
//
// This file is the only source of the palette. tools/tokens.py writes
// src/ui/generated_tokens.hpp from it, and libfinnui consumes that header.
// make lint fails when the generated file is stale.
//
// A colour is one name with two halves, the light one and the dark one,
// because the appearance switch is a property of the whole theme and
// never of a single surface. Everything else is declared once.

theme FinnTokens {
  // ---- the palette ----------------------------------------------------
  // Bone and ink. The chrome is bone; the text on it is ink.

  color: bone_light #FBFBFD, bone_dark #0D0F14
  color: tile_light #FFFFFF, tile_dark #161922
  color: tile_on_light #DCEBFF, tile_on_dark #223B61
  color: hair_light #14000000, hair_dark #1CFFFFFF

  color: ink_light #0F141A, ink_dark #F2F4F8
  color: mute_light #868E9B, mute_dark #8891A0
  color: dim_light #525866, dim_dark #9EA6B5

  // The family accent is the same in both appearances: it is the brand's
  // colour, not the appearance's (#007BFF in Figma).
  color: accent_light #007BFF, accent_dark #007BFF

  color: track_light #80000000, track_dark #3B4048
  color: knob_light #FFFFFF, knob_dark #EDE9E1

  // `on` and `fill` are the accent and the track at full strength.
  color: on_light #007BFF, on_dark #0A84FF
  color: fill_light #FFFFFF, fill_dark #EDE9E1

  // The tint of the frosted chrome: near-white in the light appearance,
  // and the deep charcoal/bone in the dark one (#414141B2 in Figma dark notifications).
  color: glass_light #FBFBFD, glass_dark #161922
  color: nav_sel_light #120F141A, nav_sel_dark #24FFFFFF
  color: hero_tint_light #EBFFDF, hero_tint_dark #15221B

  // Semantic surfaces, states, and feedback tones (synced with FinnTokens).
  color: surface_canvas_light #F2F4F8, surface_canvas_dark #111319
  color: surface_input_light #F4F6FA, surface_input_dark #1C202B
  color: surface_hover_light #0E000000, surface_hover_dark #14FFFFFF
  color: surface_pressed_light #18000000, surface_pressed_dark #22FFFFFF
  color: danger_light #EF4444, danger_dark #F87171
  color: danger_hover_light #FF0202, danger_hover_dark #FF0202
  color: success_light #16A34A, success_dark #22C55E
  color: warning_light #D97706, warning_dark #F59E0B

  // ---- the spacing scale (4px / 4dp base) ----------------------------
  // Every layout padding, margin, and gap snaps to a 4px multiple
  // (with 2px reserved strictly for hairline/micro offsets).

  spacing: sp_0 0, sp_half 2, sp_1 4, sp_2 8, sp_3 12, sp_4 16, sp_5 20, sp_6 24, sp_8 32, sp_10 40, sp_12 48, sp_16 64

  // ---- the radii ------------------------------------------------------
  // A surface's radius is a fraction of its smallest dimension.
  // Canonical discrete scale (r_xs..r_xl) plus Figma-measured aliases.

  radius: r_xs 4.0       // checkboxes, window control buttons, small indicators
  radius: r_sm 6.0       // cards, buttons, inputs, Control Center sub-tiles
  radius: r_md 8.0       // app icon tiles, hover fills, in-app toasts
  radius: r_lg 12.0      // windows, dock pills, Home/Search/Control Center panels
  radius: r_xl 20.0      // notification cards, mobile/tablet bottom sheets
  radius: r_bubble 10.4  // legacy ref-8 alias for dock pills
  radius: r_panel 10.4   // legacy ref-8 alias for Control Center and Home Menu
  radius: r_tile 5.37    // legacy ref-4.14 alias for status sub-tiles
  radius: r_note 10.4    // legacy ref-8 alias for menu cards
  radius: r_card 10.4    // legacy ref-8 alias for window panels
  radius: r_app 7.67     // legacy ref-5.91 alias for app chips
  radius: r_hero 39.0    // the Setup hero card (ref 30)
  radius: r_pill 999     // a slider row or action pill: half its height
  weight: corner_smoothing 0.6

  // ---- the type -------------------------------------------------------
  // One family, one weight. Hierarchy comes from size and from ink
  // against dim, never from a heavier cut of the face. Four weights ship;
  // the shell loads one of them.

  font: family "Fixel Display", weights [Regular 400, Medium 500, SemiBold 600, Bold 700]
    files: assets/fonts/FixelDisplay/*.otf, fallback: [DejaVu Sans, sans-serif]
  type: time 34/40 "Fixel Display" 400
  type: title 17/22 "Fixel Display" 400
  type: clock 18/22 "Fixel Display" 400
  type: label 12/16 "Fixel Display" 400
  type: label_sm 11/15 "Fixel Display" 400
  type: detail 10/14 "Fixel Display" 400
  type: micro 9/12 "Fixel Display" 400

  // ---- the material ---------------------------------------------------
  // The glass is the blurred wallpaper brought toward bone. glass_tile is
  // the effective density after two passes: 0.65 + 0.35 x 0.57 = 0.85.
  // The compositor uses glass_tile_pass for the second pass itself. Figma's
  // Window and Home surfaces separately use a black 3% drop shadow at (0,4),
  // blur 100; it is intentionally not a global elevation token.

  weight: glass_panel 0.65, glass_tile 0.85, glass_tile_pass 0.5714286, glass_well 0.53
  weight: surface_scale 0.92

  // ---- blur & elevation -----------------------------------------------
  // Note: compositor-level Gaussian backdrop blur in finn-comp is specified
  // here (35px) and listed in docs/architecture.md as unimplemented yet;
  // progressive list blur (20px) is implemented in apps/oobe.

  blur: blur_glass 35, blur_notification 15, blur_progressive 20
  elevation: elev_flat 0, elev_card 1, elev_window 4, elev_popover 4, elev_notification 4

  // ---- responsive breakpoints (dp) ------------------------------------
  // Desktop is implemented; phone (<600dp) and tablet (600-1024dp) are
  // specified in docs/design-language.md.

  breakpoint: bp_phone_max 599, bp_tablet_min 600, bp_tablet_max 1024, bp_desktop_min 1025

  // ---- the wallpaper --------------------------------------------------

  color: wp_blue #006FFF, wp_light #EDF4FD
  gradient: wallpaper_desktop linear(180deg, #EDF4FD 0%, #C9E0FA 50%, #76AEEB 100%)
  effect: wallpaper_flute repeating-x(lines, 1px rgba(255,255,255,0.18) every 8px)

  // ---- the motion -----------------------------------------------------
  // One copy of the shell's timings, and they are the ones in
  // src/compositor/finnmotion.h. A surface takes longer to arrive than to
  // leave, and the pointer's answer is quicker than the pointer's
  // withdrawal.

  motion: surface_open 280ms out_back
  motion: surface_close 180ms in_out
  motion: scrim_in 200ms out
  motion: scrim_out 140ms in_out
  motion: hover_in 110ms out
  motion: hover_out 200ms out
  motion: press_in 80ms out
  motion: press_out 180ms out
  motion: fill 200ms out
  motion: grid_cell 200ms out
  motion: grid_step 22ms linear
  motion: grid_delay 60ms linear
  motion: clock_tick 260ms linear
  motion: note 220ms out
  motion: theme 360ms in_out

  // The pointer's wash: a hint when the pointer arrives, a confirmation
  // when it is pressed.
  weight: wash_hover 0.055, wash_press 0.090

  // ---- the setup hero -------------------------------------------------

  gradient: hero_beam diagonal(#0A1628 0%, #1A4D9E 45%, #7AB8FF 55%, #0A1628 100%)

  // ---- the type scale on a television ---------------------------------
  // A television is read from across a room, so the same body text is
  // larger there. The same reasoning sizes a dock in points rather than
  // in pixels.

  tv_type_scale: 1.5, min_tv 32sp
}
