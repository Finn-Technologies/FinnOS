// FinnOS Desktop — the shell.
//
// This is the desktop as the compositor draws it today: the wallpaper, the
// window area, and the dock. The dock is drawn by hand in
// src/compositor/finndock.c, and this file is the reference it was drawn
// from — the numbers here are that file's numbers.
//
// The window area is managed by src/compositor/finnwindow.c: free-floating
// windows with snap, maximise, minimise and keyboard focus. It is written as
// a real area because there is a window manager to put something in it.

screen DesktopHome {
  target: Desktop (primary)
  adapt(Mobile): windows->fullscreen, dock->bottom_nav_fullwidth
  adapt(MobileXL): windows->split_max2, dock->left_rail
  adapt(TV): windows->fullscreen_single, dock->launcher_row_96h

  // ---- 1. the wallpaper ----
  // Decoded once and never redrawn. The appearance switch does not touch
  // it: the picture is what the room looks like, and the shell re-grades
  // on top of it.

  Wallpaper {
    fill: token.wallpaper_desktop + token.wallpaper_flute
    mode: fill, cache: gpu_static_1080p
  }

  // ---- 2. the window area (Figma 12:2) ----
  // Managed by src/compositor/finnwindow.c.

  WindowArea {
    present: true
    layout: freeform, snap: 8pt_grid
    empty_hint: "Empty window"
  }

  // ---- 3. the dock (Figma 7:41) ----
  // Frosted glass, the same material as the panels: the blurred wallpaper
  // brought toward bone at 0.70. No shadow — the reference's edges are a
  // hard one-pixel step, and a soft drop shadow would fight the glass.
  //
  // At rest it floats clear of the bottom edge as three bubbles. A window
  // that is maximized, or that reaches this band, asks it to sink: no
  // bottom margin, one surface instead of three, and the controls closer
  // together, so the window keeps the room the gaps were using.

  Dock {
    placement: bottom_center, margin_bottom: 34px
    glass: token.glass_panel
    radius: token.r_bubble
    elevation: 0
    gap: 19.5px
    when: window_reaches_dock
    margin_bottom_compact: 0px
    gap_compact: 7.5px
    padding_compact: 18px

    Row(gap: 19.5px, align: center) {

      // The Taskbar / Windows slot (Figma 7:41 "Taskbar").

      Bubble(id: apps, icon: grid_2x2, ink: token.ink, size: 65px,
             radius: token.r_bubble, enabled: true,
             on_tap: shell.toggle_windows) {
        state: idle
      }

      // The launcher. It opens the Start Menu.

      Bubble(id: launcher, icon: grid_2x2, ink: token.ink, size: 65px,
             radius: token.r_bubble, on_tap: shell.open_start_menu) {
        state: idle
      }

      // The tray. It holds two controls and nothing else: the status
      // block, which opens the Control Center, and the clock, which opens
      // the clock page. The pads either side of them and the gap between
      // them are surface, not controls.

      Tray {
        glass: token.glass_panel
        radius: token.r_bubble
        padding: 21px

        StatusBlock(id: tray, inset: 9px, padding_x: 12px,
                    on_tap: shell.open_control_center) {
          Icon(id: volume, ink: 22px, bind: audio.level)
          Icon(id: wifi, ink: 22px, bind: net.state,
               present_when: net.has_adapter)
          Icon(id: battery, ink: 19px, bind: power.level,
               present_when: power.has_battery)
        }

        Clock(id: clock, style: token.clock, bind: system.time,
              on_tap: shell.open_clock_page)
      }
    }
  }

  // The pointer answers in colour, never in movement: a control takes a
  // wash of ink, and nothing moves under the pointer.

  motion: hover token.wash_hover, press token.wash_press
  motion: hover_in token.hover_in, hover_out token.hover_out
  motion: press_in token.press_in, press_out token.press_out
}
