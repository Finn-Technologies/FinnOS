// The FinnOS Start Menu — the system's front door.
//
// It is the one surface that is not anchored to a control, so it stands in
// the middle of the screen and the desktop dims behind it. Everything
// inside it is the Control Center's language: the same glass, the same
// corner radii, the same ink.
//
// The grid comes from the application registry, which says which apps
// exist; the package manager says which of them are on this machine. An
// app that is not installed is drawn as what it is — present in the
// catalogue, absent from the machine — rather than as a live tile that
// does nothing when it is pressed.
//
// Drawn by src/compositor/finnmenu.c.

screen StartMenu {
  target: Desktop (primary)
  adapt(Mobile): columns->2, width->360px
  adapt(MobileXL): columns->4
  adapt(TV): columns->4, type_scale 1.5

  // ---- the scrim ----
  // The desktop does not go away when the menu opens, it stops being the
  // thing you are looking at. The scrim is shorter than the menu's open
  // in both directions, so the room is already dim when the menu appears
  // and already brightening when the menu starts to go.

  Scrim {
    colour: #000000
    strength: 0.30
    motion: in token.scrim_in, out token.scrim_out
  }

  // ---- the card ----
  // A launcher has to hold a grid, and a grid does not fit in the width of
  // a control panel, so the menu's width is its own. The height follows
  // the number of app rows.

  Card {
    placement: center
    width: 760px
    glass: token.glass_panel
    radius: token.r_card
    padding: 28px
    gap: 24px
    motion: open token.surface_open, close token.surface_close
    motion: scale token.surface_scale
    anchor: own_center
  }

  // ---- the header ----
  // It says what is true: how many of the catalogue's apps this machine
  // can actually open.

  Header {
    title: "Applications"
    style: token.title
    ink: token.ink
    detail: count_ready
    detail_style: token.micro
    detail_ink: token.mute
    gap: 24px
  }

  // ---- the grid ----
  // Four columns. A cell's tile is centred in it, so a row of tiles reads
  // as a row rather than as a staircase.

  Grid(columns: 4, gap: 18px, cell: 176px) {
    AppTile(id: code, name: "Finn Code", note: "Editor", icon: code.svg)
    AppTile(id: files, name: "Finn Files", note: "File manager", icon: files.svg)
    AppTile(id: notes, name: "Finn Notes", note: "Notes", icon: notes.svg)
    AppTile(id: studio, name: "Finn Studio", note: "Visual FinnUI designer", icon: studio.svg)
    AppTile(id: store, name: "Finn Store", note: "App distribution", icon: store.svg)
    AppTile(id: sync, name: "Finn Sync", note: "Device-to-device sync", icon: sync.svg)
    AppTile(id: vault, name: "Finn Vault", note: "Credentials and keys", icon: vault.svg)
    AppTile(id: term, name: "Finn Terminal", note: "Shell host", icon: terminal.svg)
  }

  // An app tile is the app's own square.
  //
  // Installed, it is the accent at full strength with a white glyph, and
  // its name is in the ink. Not installed, it is a quiet wash with a mute
  // glyph, the name is dim, and the detail line reads "Not installed". A
  // muted tile says "not here" more honestly than a coloured one that
  // does nothing when it is pressed — and it takes no hover and no press,
  // because there is nothing behind it to promise.

  AppTile {
    size: 76px
    radius: token.r_app
    icon_ink: 40px
    gap: 12px
    caption_style: token.label
    detail_style: token.micro
    states: installed, not_installed
    installed: fill token.on, glyph token.knob, name token.ink, note token.mute
    not_installed: fill token.ink @ 0.10, glyph token.mute, name token.dim, note token.mute
    not_installed_note: "Not installed"
    motion: hover token.wash_hover, press token.wash_press
    motion: arrive token.grid_cell, step token.grid_step, delay token.grid_delay
  }

  // ---- the footer ----
  // The wordmark, and the two things the menu can do that are not an app.
  // They are drawn like every other control rather than as a line of
  // quiet text that happens to be clickable.

  Footer {
    rule: token.hair
    gap: 20px

    Wordmark(text: "FinnOS", style: token.title, ink: token.ink)

    Row(gap: 24px) {
      Action(id: restart, text: "Restart", ink: token.dim,
             on_tap: power.restart)
      Action(id: shutdown, text: "Shut down", ink: token.dim,
             on_tap: power.shutdown)
    }
  }
}
