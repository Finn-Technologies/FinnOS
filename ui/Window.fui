// FinnOS Window Surface (Figma 12:2).
// Drawn by src/compositor/finnwindow.c.

screen Window {
  target: Desktop (primary)

  Panel(width: 649px, height: 389.4px, radius: token.r_card,
        glass: token.glass_panel) {

    WindowOptions(placement: top_right, inset: 10.4px,
                  width: 93.5px, height: 31.2px, radius: token.r_tile,
                  glass: token.glass_tile) {
      IconButton(id: expand, icon: window_expand.svg, on_tap: window.maximize)
      IconButton(id: minimize, icon: window_minimize.svg, on_tap: window.minimize)
      IconButton(id: close, icon: window_close.svg, on_tap: window.close)
    }

    EmptyLabel(text: "Empty window", style: token.label, ink: token.ink)
  }
}
