// FinnOS Notification Center — Empty & Items (Figma 13:31 & 13:129).
// Drawn by src/compositor/finnclock.c.

screen NotificationCenter {
  target: Desktop (primary)

  Panel(width: 338px, height: 338px, radius: token.r_panel,
        glass: token.glass_panel, padding: 18.2px) {

    Header(gap: 13px) {
      Time(bind: system.time, style: token.clock, ink: token.ink)
      Date(bind: system.date, style: token.label, ink: token.ink, dim: token.dim)
    }

    EmptyState(text: "No notifications", style: token.label, ink: token.dim)

    NotificationList(slots: 4, gap: 10.4px, card_height: 46.7px,
                     radius: token.r_note, glass: token.glass_tile)

    Pill(id: clear_all, width: 71.4px, height: 29.9px, radius: token.r_pill,
         glass: token.glass_tile, text: "Clear all", on_tap: notify.clear)
  }
}
