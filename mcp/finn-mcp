    if a.get("x") is None or a.get("y") is None:
        return "window.move needs x and y", True
    x, y = int(a["x"]), int(a["y"])
    ok, _out, err = ctl("window.move", "id=%d" % win, "x=%d" % x, "y=%d" % y)
    if not ok:
        return err or "window.move failed", True
    return "window %d at %d,%d" % (win, x, y), False


def tool_setup_get(_a):
