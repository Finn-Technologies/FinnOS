#!/usr/bin/env python3
"""
finn-mcp — Model Context Protocol server for FinnOS.

Exposes the FinnOS control plane (finnd) as MCP tools, so an agent can drive
a running system the way a user would: move the pointer, set device state,
read the framebuffer.

Layering, deliberately:

    agent  --MCP/JSON-RPC-->  finn-mcp  --ssh-->  finnctl  --socket-->  finnd

MCP is a transport, not the OS API. The device speaks a small line protocol
(finnproto.h) and nothing else; all JSON lives here, on the machine the agent
runs on. That keeps a fast-moving external spec out of the operating system,
and means the same control plane is scriptable with nothing but ssh:

    ssh finn@host finnctl state.set battery=42

Implemented without the official SDK so it runs on any Python 3.6+ host.

Configuration (environment):
    FINN_HOST       ssh target for the device   (default finn@10.211.55.6)
    FINN_SSH_PORT   ssh port                    (default 22)
    FINN_TIMEOUT    per-call timeout, seconds   (default 120)

Check connectivity without an MCP client:
    ./finn-mcp --check
"""

import base64
import json
import os
import subprocess
import sys
import tempfile

PROTOCOL_VERSION = "2024-11-05"
SUPPORTED_PROTOCOLS = ("2024-11-05", "2025-03-26", "2025-06-18")
SERVER_NAME = "finnos"
SERVER_VERSION = "0.1.0"

HOST = os.environ.get("FINN_HOST", "finn@10.211.55.6")
PORT = os.environ.get("FINN_SSH_PORT", "22")
TIMEOUT = float(os.environ.get("FINN_TIMEOUT", "120"))

SSH_BASE = [
    "ssh", "-p", PORT,
    "-o", "BatchMode=yes",
    "-o", "StrictHostKeyChecking=no",
    "-o", "UserKnownHostsFile=/dev/null",
    "-o", "LogLevel=ERROR",
    HOST,
]


# ---------------------------------------------------------------- transport

def _run(args, binary=False, attempts=3):
    """Run `finnctl <args>` on the device. Returns (ok, stdout, stderr).

    Retries transport-level failures: an ssh hiccup returns non-zero with no
    diagnostic, whereas a rejected command returns non-zero *with* a message
    from finnctl. Only the former is worth retrying.
    """
    cmd = SSH_BASE + ["finnctl"] + list(args)
    last = (False, b"" if binary else "", "no attempt made")

    for attempt in range(attempts):
        try:
            p = subprocess.run(cmd, capture_output=True, timeout=TIMEOUT)
        except subprocess.TimeoutExpired:
            last = (False, b"" if binary else "", "timed out after %gs" % TIMEOUT)
            continue
        except FileNotFoundError:
            return False, b"" if binary else "", "ssh not found on this host"

        err = p.stderr.decode(errors="replace").strip()
        if p.returncode != 0 and not err and attempt < attempts - 1:
            last = (False, b"" if binary else "", "ssh returned %d with no output" % p.returncode)
            continue

        if binary:
            return p.returncode == 0, p.stdout, err
        return p.returncode == 0, p.stdout.decode(errors="replace").strip(), err

    return last


def ctl(*args):
    return _run(args)


def ctl_binary(*args):
    return _run(args, binary=True)


def parse_kv(text):
    """Turn `battery=82 charging=0 wifi=3 volume=70` into a dict of numbers."""
    out = {}
    for tok in text.split():
        if "=" not in tok:
            continue
        k, v = tok.split("=", 1)
        for cast in (int, float):
            try:
                out[k] = cast(v)
                break
            except ValueError:
                continue
        else:
            out[k] = v
    return out


def parse_apps(text):
    """Turn `count=3 [id|state|name] [id|state|name]` into a list of apps.

    The registry is the one place where an app is honestly "not
    installed", so the state is carried through rather than smoothed
    over: the caller can see which apps this machine actually has.
    """
    apps = []
    for chunk in text.split("[")[1:]:
        chunk = chunk.strip().rstrip("]")
        parts = chunk.split("|")
        if len(parts) >= 3:
            apps.append({"id": parts[0], "state": parts[1], "name": parts[2]})
    return apps


# ---------------------------------------------------------------- tools

def tool_state_get(_a):
    ok, out, err = ctl("state.get")
    if not ok:
        return err or "device unreachable", True
    st = parse_kv(out)
    lines = []
    bat = st.get("battery", -1)
    lines.append("battery: %s" % ("mains / no battery" if bat is None or bat < 0 else "%d%%" % bat))
    if st.get("charging"):
        lines.append("charging: yes")
    wifi = st.get("wifi", -1)
    lines.append("wifi signal: %s" % ("no interface" if wifi is None or wifi < 0 else "%d/3" % wifi))
    vol = st.get("volume", -1)
    lines.append("volume: %s" % ("unknown" if vol is None or vol < 0 else "%d%%" % vol))
    return "\n".join(lines), False


def tool_state_set(a):
    args = []
    for key in ("battery", "charging", "wifi", "volume"):
        if a.get(key) is not None:
            args.append("%s=%d" % (key, int(a[key])))
    if not args:
        return "no state keys given (battery, charging, wifi, volume)", True
    ok, _out, err = ctl("state.set", *args)
    if not ok:
        return err or "state.set failed", True
    return "set " + " ".join(args), False


def tool_state_clear(_a):
    ok, _out, err = ctl("state.clear")
    if not ok:
        return err or "state.clear failed", True
    return "cleared overrides; state now reflects real hardware", False


def tool_pointer_move(a):
    x, y = int(a.get("x", 0)), int(a.get("y", 0))
    ok, _out, err = ctl("pointer.move", "x=%d" % x, "y=%d" % y)
    if not ok:
        return err or "pointer.move failed", True
    return "pointer at %d,%d" % (x, y), False


def tool_pointer_by(a):
    dx, dy = int(a.get("dx", 0)), int(a.get("dy", 0))
    ok, _out, err = ctl("pointer.by", "dx=%d" % dx, "dy=%d" % dy)
    if not ok:
        return err or "pointer.by failed", True
    return "moved by %d,%d" % (dx, dy), False


def tool_pointer_click(a):
    button = a.get("button", "left")
    calls = []
    if a.get("x") is not None and a.get("y") is not None:
        calls.append(["pointer.move", "x=%d" % int(a["x"]), "y=%d" % int(a["y"])])
    calls.append(["pointer.click", "button=%s" % button])
    for c in calls:
        ok, _out, err = ctl(*c)
        if not ok:
            return err or ("%s failed" % c[0]), True
    return "%s click" % button, False


def tool_pointer_scroll(a):
    dy = int(a.get("dy", 0))
    ok, _out, err = ctl("pointer.scroll", "dy=%d" % dy)
    if not ok:
        return err or "pointer.scroll failed", True
    return "scrolled by %d" % dy, False


def tool_screen_info(_a):
    ok, out, err = ctl("screen.info")
    if not ok:
        return err or "device unreachable", True
    st = parse_kv(out)
    return "framebuffer %sx%s (density %.2f)" % (st.get("w"), st.get("h"), st.get("scale", 0.0)), False


def tool_screenshot(a):
    step = int(a.get("step", 2))
    if step < 1:
        step = 1
    ok, raw, err = ctl_binary("screen.capture", "step=%d" % step, "-o", "-")
    if not ok or not raw.startswith(b"P6"):
        return err or "capture failed", True

    try:
        from PIL import Image  # optional: only needed for PNG conversion
        import io
        im = Image.open(io.BytesIO(raw))
        buf = io.BytesIO()
        im.save(buf, format="PNG", optimize=True)
        data = buf.getvalue()
        mime = "image/png"
        note = "%dx%d PNG" % im.size
    except ImportError:
        # no PIL: hand back a PPM file the caller can open
        fd, path = tempfile.mkstemp(suffix=".ppm", prefix="finn-")
        with os.fdopen(fd, "wb") as f:
            f.write(raw)
        return [{"type": "text", "text": "PIL unavailable; frame written to %s" % path}], False
    except Exception as exc:
        return "capture decode failed: %s" % exc, True

    return [
        {"type": "text", "text": "FinnOS framebuffer, %s (1/%d scale)" % (note, step)},
        {"type": "image", "data": base64.b64encode(data).decode("ascii"), "mimeType": mime},
    ], False


def tool_log(a):
    lines = int(a.get("lines", 40))
    ok, out, err = _run(["log", str(lines)])
    if not ok:
        return err or "log unavailable", True
    return out or "(no output)", False


def tool_power(a):
    action = a.get("action", "restart-comp")
    if action not in ("reboot", "shutdown", "restart-comp"):
        return "action must be reboot, shutdown or restart-comp", True
    ok, _out, err = ctl("power", action)
    if not ok:
        return err or "power failed", True
    return "requested %s" % action, False


def tool_app_list(_a):
    ok, out, err = ctl("app.list")
    if not ok:
        return err or "device unreachable", True
    apps = parse_apps(out)
    if not apps:
        return "the registry is empty", False
    lines = []
    for app in apps:
        lines.append("%s  %-12s %s" % (app["id"], app["state"], app["name"]))
    return "\n".join(lines), False


def tool_app_launch(a):
    app_id = a.get("id") or a.get("app") or ""
    if not app_id:
        return "no app id given (the id from finn_app_list)", True
    ok, out, err = ctl("app.launch", app_id)
    if not ok:
        return err or "app.launch failed", True
    return out or ("launched %s" % app_id), False


