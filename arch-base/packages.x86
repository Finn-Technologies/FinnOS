# FinnOS base image — x86_64, the release target
#
# The machine this is built for: an i3-4130 (Intel HD Graphics 4400), 4 GB
# of RAM and a 1080p panel. The compositor's budget on that machine is
# under 120 MB of RAM and 60 MB of VRAM, and an idle desktop redraws
# nothing at all.

BASE=base linux linux-firmware systemd networkmanager sudo openssh
AUDIO=alsa-lib alsa-utils alsa-ucm-conf
GRAPHICS_X86=mesa vulkan-intel intel-ucode libdrm libinput seatd
FONTS=ttf-dejavu ttf-liberation
TOOLS=python python-pip git tar
BUILD=base-devel pkgconf
