# Generate a real Ed25519 keypair outside the git repository using:
#   ota/keygen --out-dir /secure/offline/finnos-keys
#
# Then install the generated public key (*-public.pem) to:
#   /etc/finn/ota/pubkey.pem
#
# Private keys must NEVER be committed to this repository.
