// Launcher - grid, same tokens as dock
screen Launcher {
  overlay(z:200, dim: rgba(0,0,0,0.3)) {
    Card(center, w:520, h:400, radius:lg, bg: surface(bind: system.theme)) {
      Grid(columns:5, gap:16, padding:20) {
        AppIcon(id:settings, label:"Settings")
        AppIcon(id:files, label:"Files")
        AppIcon(id:terminal, label:"Terminal") // foot
        AppIcon(id:notes, label:"Notes")
      }
      Text("Super+Space toggles", style:body_dim, align:center)
    }
  }
}
