// Finn Window — the basic window surface (Figma 12:2).
//
// A 500x300 frosted glass window (r=15, glass 0.70) centered on the display
// with a 72x24 top-right Window Options pill (r=8, glass 0.50, 8px inset)
// carrying expand, minimize and close controls, and a centered 12px caption.

screen FinnWindow {
  target: Desktop (primary)
  adapt(Mobile): detail->fullscreen
  adapt(MobileXL): split_view_max2
  adapt(TV): type_scale 1.5

  Frame {
    glass: token.glass_panel
    radius: token.r_panel
    padding: 8px
    gap: 8px
  }

  Header {
    OptionsPill(radius: 8px, glass: token.glass_tile, gap: 6px) {
      Action(id: expand, icon: "window_expand.svg")
      Action(id: minimize, icon: "window_minimize.svg")
      Action(id: close, icon: "window_close.svg")
    }
  }

  Body {
    Title(text: "Empty window", style: token.label, ink: token.dim)
  }
}
