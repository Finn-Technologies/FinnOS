// Finn Store — the app distribution front end.
//
// A design, not a running program: there is no compositor client protocol
// yet, so an app cannot draw itself. `fuic` compiles this to a .fbin and
// the system does not draw it yet — see docs/architecture.md, "What is not
// here yet".
//
// The store's honesty rule is the shell's: the button says what will
// happen. An app that is already installed offers "Open", and one that is
// not offers "Install" — never a button that does nothing.

screen FinnStore {
  target: Desktop (primary)
  adapt(Mobile): columns->1, detail->sheet
  adapt(MobileXL): columns->2
  adapt(TV): type_scale 1.5

  Frame {
    glass: token.glass_panel
    radius: token.r_panel
    padding: 10.4px
    gap: 10.4px
  }

  // ---- what is being looked at ----
  Header {
    title: "Store"
    style: token.title
    ink: token.ink
    detail: "8 apps in the catalogue"
    detail_style: token.micro
    detail_ink: token.mute
  }

  // ---- the catalogue ----
  // The first-party family, with the state of this machine beside each
  // one. The state is the honest part: a row says "Installed" or
  // "Not installed", and the button matches it.

  List(gap: 10.4px) {
    Row {
      Icon(id: code, ink: 40px)
      Column(gap: 4px) {
        Text(text: "Finn Code", style: token.label, ink: token.ink)
        Text(text: "Editor", style: token.micro, ink: token.mute)
      }
      Text(text: "Not installed", style: token.micro, ink: token.dim)
      Button(text: "Install", state: idle, on_tap: package.install)
    }
    Row {
      Icon(id: files, ink: 40px)
      Column(gap: 4px) {
        Text(text: "Finn Files", style: token.label, ink: token.ink)
        Text(text: "File manager", style: token.micro, ink: token.mute)
      }
      Text(text: "Installed", style: token.micro, ink: token.mute)
      Button(text: "Open", state: idle, on_tap: app.launch)
    }
    Row {
      Icon(id: notes, ink: 40px)
      Column(gap: 4px) {
        Text(text: "Finn Notes", style: token.label, ink: token.ink)
        Text(text: "Notes", style: token.micro, ink: token.mute)
      }
      Text(text: "Not installed", style: token.micro, ink: token.dim)
      Button(text: "Install", state: idle, on_tap: package.install)
    }
    Row {
      Icon(id: studio, ink: 40px)
      Column(gap: 4px) {
        Text(text: "Finn Studio", style: token.label, ink: token.ink)
        Text(text: "Visual FinnUI designer", style: token.micro, ink: token.mute)
      }
      Text(text: "Not installed", style: token.micro, ink: token.dim)
      Button(text: "Install", state: idle, on_tap: package.install)
    }
    Row {
      Icon(id: store, ink: 40px)
      Column(gap: 4px) {
        Text(text: "Finn Store", style: token.label, ink: token.ink)
        Text(text: "App distribution", style: token.micro, ink: token.mute)
      }
      Text(text: "Installed", style: token.micro, ink: token.mute)
      Button(text: "Open", state: idle, on_tap: app.launch)
    }
    Row {
      Icon(id: sync, ink: 40px)
      Column(gap: 4px) {
        Text(text: "Finn Sync", style: token.label, ink: token.ink)
        Text(text: "Device-to-device sync", style: token.micro, ink: token.mute)
      }
      Text(text: "Not installed", style: token.micro, ink: token.dim)
      Button(text: "Install", state: idle, on_tap: package.install)
    }
    Row {
      Icon(id: vault, ink: 40px)
      Column(gap: 4px) {
        Text(text: "Finn Vault", style: token.label, ink: token.ink)
        Text(text: "Credentials and keys", style: token.micro, ink: token.mute)
      }
      Text(text: "Not installed", style: token.micro, ink: token.dim)
      Button(text: "Install", state: idle, on_tap: package.install)
    }
    Row {
      Icon(id: term, ink: 40px)
      Column(gap: 4px) {
        Text(text: "Finn Terminal", style: token.label, ink: token.ink)
        Text(text: "Shell host", style: token.micro, ink: token.mute)
      }
      Text(text: "Installed", style: token.micro, ink: token.mute)
      Button(text: "Open", state: idle, on_tap: app.launch)
    }
  }
}
