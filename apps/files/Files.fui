// Finn Files — the file manager.
//
// A design, not a running program: there is no compositor client protocol
// yet, so an app cannot draw itself. `fuic` compiles this to a .fbin and
// the system does not draw it yet — see docs/architecture.md, "What is not
// here yet".
//
// The path bar is the important part: a file manager that cannot say where
// it is is a list of names.

screen FinnFiles {
  target: Desktop (primary)
  adapt(Mobile): sidebar->none, columns->1
  adapt(MobileXL): sidebar->rail, columns->2
  adapt(TV): type_scale 1.5

  Frame {
    glass: token.glass_panel
    radius: token.r_panel
    padding: 10.4px
    gap: 10.4px
  }

  // ---- the places ----
  Sidebar(width: 180px) {
    Label(text: "Places", style: token.micro, ink: token.mute)
    Item(text: "Home", icon: home, state: active)
    Item(text: "Documents", icon: folder, state: idle)
    Item(text: "Downloads", icon: folder, state: idle)
    Item(text: "Devices", icon: disk, state: idle)
  }

  // ---- where we are ----
  PathBar {
    Crumb(text: "Home", state: active)
    Crumb(text: "ui", state: idle)
    Crumb(text: "_tokens.fui", state: current)
  }

  // ---- what is here ----
  // A name, a size and a date, in the shell's own rhythm. The name is in
  // the ink; everything else is detail, in the dim.

  FileGrid(columns: 3, gap: 12px) {
    File(name: "_targets.fui", size: "2.1 kB", modified: "today", kind: file, state: idle)
    File(name: "Desktop.fui", size: "3.4 kB", modified: "today", kind: file, state: idle)
    File(name: "StartMenu.fui", size: "4.8 kB", modified: "today", kind: file, state: idle)
    File(name: "apps", size: "8 items", modified: "today", kind: folder, state: idle)
  }

  // ---- the selection ----
  // One line, at the bottom, saying what is selected and what it weighs.
  // Nothing is selected by default.

  StatusLine {
    Row(gap: 16px) {
      Text(text: "1 item", style: token.micro, ink: token.mute)
      Text(text: "2.1 kB", style: token.micro, ink: token.mute)
    }
    Row {
      Text(text: "5 items", style: token.micro, ink: token.dim)
    }
  }
}
