// Finn Sync — device-to-device sync.
//
// A design, not a running program: there is no compositor client protocol
// yet, so an app cannot draw itself. `fuic` compiles this to a .fbin and
// the system does not draw it yet — see docs/architecture.md, "What is not
// here yet".
//
// The honest part is the state of each device: a machine that has never
// paired says so, and the button that would pair it is not a switch that
// pretends to be on.

screen FinnSync {
  target: Desktop (primary)
  adapt(Mobile): detail->sheet
  adapt(MobileXL): split_view_max2
  adapt(TV): type_scale 1.5

  Frame {
    glass: token.glass_panel
    radius: token.r_panel
    padding: 10.4px
    gap: 10.4px
  }

  Header {
    title: "Sync"
    style: token.title
    ink: token.ink
    detail: "2 devices"
    detail_style: token.micro
    detail_ink: token.mute
  }

  // ---- the devices ----
  // This machine is always first, and it is never given a button: there
  // is nothing to sync it with but itself.

  List(gap: 10.4px) {
    Row {
      Icon(id: this_machine, ink: 40px)
      Column(gap: 4px) {
        Text(text: "This machine", style: token.label, ink: token.ink)
        Text(text: "Up to date", style: token.micro, ink: token.mute)
      }
      Text(text: "Current", style: token.micro, ink: token.dim)
    }
    Row {
      Icon(id: laptop, ink: 40px)
      Column(gap: 4px) {
        Text(text: "Abel's laptop", style: token.label, ink: token.ink)
        Text(text: "Synced 4 minutes ago", style: token.micro, ink: token.mute)
      }
      Button(text: "Sync now", state: idle, on_tap: sync.run)
    }
    Row {
      Icon(id: phone, ink: 40px)
      Column(gap: 4px) {
        Text(text: "Abel's phone", style: token.label, ink: token.ink)
        Text(text: "Never paired", style: token.micro, ink: token.mute)
      }
      Button(text: "Pair", state: idle, on_tap: sync.pair)
    }
  }

  // ---- what is carried ----
  // What sync moves. Notes and files, and nothing that has not been said
  // out loud.

  Section(title: "What is synced") {
    Toggle(text: "Notes", bind: sync.notes, default: true)
    Toggle(text: "Files", bind: sync.files, default: false)
    Toggle(text: "Credentials", bind: sync.vault, default: false)
  }
}
