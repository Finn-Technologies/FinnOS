// Finn Vault — credentials and keys.
//
// A design, not a running program: there is no compositor client protocol
// yet, so an app cannot draw itself. `fuic` compiles this to a.fbin and
// the system does not draw it yet — see docs/architecture.md, "What is not
// here yet".
//
// The vault is locked by default, and a locked vault says so. It does not
// show a list of what it holds while it is shut.

screen FinnVault {
  target: Desktop (primary)
  adapt(Mobile): detail->sheet
  adapt(MobileXL): split_view_max2
  adapt(TV): type_scale 1.5

  Frame {
    glass: token.glass_panel
    radius: token.r_panel
    padding: 10.4px
    gap: 10.4px
  }

  // ---- the lock ----
  // The default state, and the only one that is drawn until the vault is
  // opened. There is no list behind it.

  Locked {
    Icon(id: vault, ink: 40px)
    Text(text: "The vault is locked", style: token.label, ink: token.ink)
    Text(text: "Unlock with your passphrase to see what it holds.",
         style: token.detail, ink: token.mute)
    Field(name: passphrase, style: token.label, secure: true)
    Button(text: "Unlock", state: idle, on_tap: vault.unlock)
  }

  // ---- what is inside ----
  // The list only exists once the vault is open. A name, what it is for,
  // and when it was last used — never the secret itself.

  Unlocked {
    List(gap: 10.4px) {
      Item(title: "github.com", kind: "password", used: "today")
      Item(title: "FinnOS signing key", kind: "key", used: "never")
      Item(title: "finn.dev", kind: "password", used: "last week")
    }
    Column(gap: 4px) {
      Text(text: "github.com", style: token.label, ink: token.ink)
      Text(text: "Password · last used today", style: token.micro, ink: token.mute)
      Field(name: password, style: token.label, secure: true)
      Button(text: "Copy", state: idle, on_tap: vault.copy)
    }
  }
}
