// Finn Studio — the visual FinnUI designer.
//
// A design, not a running program: there is no compositor client protocol
// yet, so an app cannot draw itself. `fuic` compiles this to a .fbin and
// the system does not draw it yet — see docs/architecture.md, "What is not
// here yet".
//
// The designer edits the same tokens the shell draws with, so the palette
// it shows is the palette in ui/_tokens.fui and the timings it offers are
// the timings in src/compositor/finnmotion.h.

screen FinnStudio {
  target: Desktop (primary)
  adapt(Mobile): layers->none, inspector->sheet
  adapt(MobileXL): split_view_max2
  adapt(TV): type_scale 1.5

  Frame {
    glass: token.glass_panel
    radius: token.r_panel
    padding: 10.4px
    gap: 10.4px
  }

  // ---- the tree ----
  Sidebar(width: 220px) {
    Label(text: "Layers", style: token.micro, ink: token.mute)
    Tree {
      Item(text: "Desktop", state: idle)
      Item(text: "Dock", state: active)
      Item(text: "Tray", state: idle)
      Item(text: "StartMenu", state: idle)
    }
  }

  // ---- the canvas ----
  // The canvas is the wallpaper, and the shell is drawn on top of it, at
  // the same scale the compositor would draw it.

  Canvas {
    background: token.wallpaper_desktop
    zoom: 1.0
    artboard: 1920x1080

    Frame(id: dock, x: 668, y: 980, width: 584, height: 96) {
      glass: token.glass_panel
      radius: token.r_bubble
    }
  }

  // ---- the inspector ----
  // The tokens, by their names, with the values the code uses.

  Inspector(width: 260px) {
    Section(title: "Fill") {
      Swatch(name: "glass_panel", colour: token.glass, weight: token.glass_panel)
      Swatch(name: "on", colour: token.on)
      Swatch(name: "ink", colour: token.ink)
    }
    Section(title: "Radius") {
      Field(name: "r_bubble", value: token.r_bubble)
      Field(name: "r_panel", value: token.r_panel)
    }
    Section(title: "Motion") {
      Field(name: "surface_open", value: token.surface_open)
      Field(name: "surface_close", value: token.surface_close)
      Field(name: "hover_in", value: token.hover_in)
    }
    Section(title: "Type") {
      Field(name: "label", value: token.label)
      Field(name: "detail", value: token.detail)
    }
  }

  StatusLine {
    Text(text: "Dock.fui", style: token.micro, ink: token.mute)
    Text(text: "1920x1080", style: token.micro, ink: token.dim)
  }
}
